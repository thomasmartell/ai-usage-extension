{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.1.8",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "alarms",
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://api.github.com/*",
    "https://github.com/login/*",
    "https://api.netlify.com/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/sidepanel.html",
    "default_icon": {
      "16": "icons/badges/range-10.png",
      "32": "icons/badges/range-10.png",
      "48": "icons/badges/range-10.png",
      "128": "icons/badges/range-10.png"
    },
    "default_title": "__MSG_appShortName__"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
